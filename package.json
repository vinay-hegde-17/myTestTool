{
  "name": "phye-hrms-playwright",
  "version": "1.0.0",
  "description": "Playwright SDET framework for PHYE-HRMS API and E2E testing",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:api": "node scripts/run-tests.js --project=api",
    "test:smoke": "node scripts/run-tests.js --project=api --grep @smoke",
    "test:sanity": "node scripts/run-tests.js --project=api --grep @sanity",
    "test:regression": "node scripts/run-tests.js --project=api --grep @regression",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "npm run allure:open",
    "allure:open": "node scripts/run-tests.js --open-report",
    "test:empty": "npx playwright test tests/empty --grep @emptydata"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinay-hegde-17/myTestTool.git"
  },
  "keywords": ["playwright", "sdet", "api-testing", "hrms"],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2"
  }
}
