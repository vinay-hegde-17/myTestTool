{
  "name": "phye-hrms-playwright",
  "version": "1.0.0",
  "description": "Playwright SDET framework for PHYE-HRMS API and E2E testing",
  "scripts": {
    "test": "npx playwright test --project=api && npx playwright test --project=empty",
    "test:api": "npx playwright test --project=api",
    "test:empty": "npx playwright test --project=empty",
    "test:smoke": "npx playwright test --project=api --grep @smoke",
    "test:sanity": "npx playwright test --project=api --grep @sanity",
    "test:regression": "npx playwright test --project=api --grep @regression",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "npm run allure:open",
    "allure:open": "node scripts/run-tests.js --open-report",
    "db:clean": "node scripts/clean-framework-db-data.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinay-hegde-17/myTestTool.git"
  },
  "keywords": [
    "playwright",
    "sdet",
    "api-testing",
    "hrms"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "allure-playwright": "^3.9.0",
    "dotenv": "^17.4.2",
    "mongodb": "^6.21.0"
  }
}
